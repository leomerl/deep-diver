# Both workers (index and deep dive). They clone untrusted repos, so compose runs this image read-only, unprivileged
# and on an internal network; see the x-worker block in docker-compose.yml.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /bin/uv

# git only: no git-lfs, so a repo can't trigger LFS downloads or smudge filters.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home worker
WORKDIR /srv

# Dependencies first, so code changes don't reinstall them (layer cache).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app
USER worker

# GIT_ALLOW_PROTOCOL: git may only speak https, so ext::, file:// and ssh:// URLs fail even from inside a repo.
# Set here rather than in app/git/run.py because the tests clone file:// repos.
# PYTHONDONTWRITEBYTECODE: the root filesystem is read-only, so don't try to write __pycache__.
# PATH: `python` is the venv's, which also makes sys.executable (used by load_import_graph) the venv's.
ENV GIT_ALLOW_PROTOCOL=https \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/srv/.venv/bin:$PATH
