  /* A reading page in the manner of Apple's developer articles: white paper, one sans family, quiet code.
     Inline code is a typeface change, not a chip: the prose names many identifiers, and grey boxes on each turn a
     paragraph into confetti. Code panels follow the page theme (light on light), so the page has no heavy slabs.
     System fonts only (the CSP blocks web fonts): system-ui and ui-monospace are SF Pro and SF Mono on Apple devices. */
  :root { color-scheme: light dark;
          --fg: #1d1d1f; --body: #333336; --muted: #6e6e73; --bg: #fff; --fill: #f5f5f7; --fill-2: #e8e8ed;
          --border: #d2d2d7; --accent: #0066cc; --on-accent: #fff; --tip: #1b7f3a; --info: #6e6e73; --warning: #c93400;
          --code-bg: #f5f5f7; --code-fg: #1d1d1f; --code-dim: #6e6e73; --code-path: #1d1d1f;
          --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI Variable Text", "Segoe UI", Roboto, sans-serif;
          --mono: ui-monospace, "SF Mono", Menlo, Consolas, "Cascadia Mono", monospace; }
  @media (prefers-color-scheme: dark) {
    /* #2997ff with white text is only 3.0:1, so filled blue controls take black text in dark mode. */
    :root { --fg: #f5f5f7; --body: #d1d1d6; --muted: #98989d; --bg: #161618; --fill: #232326; --fill-2: #2e2e32;
            --border: #3a3a3e; --accent: #2997ff; --on-accent: #000; --tip: #30d158; --info: #98989d; --warning: #ff9f0a;
            --code-bg: #1f1f24; --code-fg: #dfdfe0; --code-dim: #8e8e96; --code-path: #f5f5f7; }
  }
  @media (prefers-contrast: more) {
    :root { --body: var(--fg); --muted: #3a3a3c; --border: #86868b; }
    .goals, .toc-top, .tech, .question, .summary, .callout, .code, .diagram .panel { outline: 1px solid var(--border); }
  }
  @media (prefers-contrast: more) and (prefers-color-scheme: dark) { :root { --muted: #c7c7cc; } }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--body); font: 1.0625rem/1.65 var(--sans); letter-spacing: -.003em;
         -webkit-text-size-adjust: 100%; -webkit-font-smoothing: antialiased; overflow-wrap: break-word; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: .18em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; top: .5rem; padding: .5rem .75rem; background: var(--bg); }
  .skip:focus { left: .5rem; z-index: 1; }
  h1, h2, h3, h4, strong, dt { color: var(--fg); }
  .icon { flex: none; width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2;
          stroke-linecap: round; stroke-linejoin: round; }

  .page { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.25rem 6rem; }
  main { max-width: 42rem; margin: 0 auto; }
  main > section { scroll-margin-top: 1.5rem; }

  /* Orientation: a contents list that stays in view on wide screens and folds away in the side panel. */
  .toc-side { display: none; }
  .toc ol { margin: 0; padding: 0; list-style: none; font-size: .875rem; line-height: 1.35; }
  .toc a { display: block; padding: .4rem .65rem; border-radius: 8px; color: var(--muted); }
  .toc a:hover { color: var(--fg); background: var(--fill); text-decoration: none; }
  .toc-title { margin: 0 0 .4rem .65rem; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .toc-top { margin: 1.5rem 0 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .toc-top summary { cursor: pointer; padding: .75rem 0; font-size: .9375rem; font-weight: 600; color: var(--fg); }
  .toc-top ol { padding-bottom: .75rem; }
  .toc-top a { padding-left: 0; }
  @media (min-width: 68rem) {
    .page { display: grid; grid-template-columns: 13rem minmax(0, 42rem); gap: 4.5rem; justify-content: center; }
    main { margin: 0; }
    .toc-side { display: block; position: sticky; top: 2.5rem; align-self: start; max-height: calc(100vh - 5rem); overflow-y: auto; }
    .toc-top { display: none; }
  }

  /* Header: a quiet label, a big title, the facts as one line of text. */
  header { padding-bottom: 1rem; }
  header::before { content: "Deep dive"; display: block; margin-bottom: .6rem; font-size: .8125rem; font-weight: 600; color: var(--accent); }
  h1 { margin: 0 0 .9rem; font-size: clamp(1.9rem, 6vw, 2.6rem); font-weight: 700; line-height: 1.1; letter-spacing: -.028em; }
  .meta { display: flex; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; font-size: .875rem; color: var(--muted); }
  .meta li + li::before { content: "·"; margin: 0 .5em; }
  .goals { margin: 2rem 0 0; padding: 1.25rem 1.4rem 1.1rem; background: var(--fill); border-radius: 18px; }
  .goals h2 { margin: 0 0 .75rem; font-size: .8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .goals ul { margin: 0; padding: 0; list-style: none; counter-reset: goal; }
  .goals li { position: relative; margin: 0; padding: .55rem 0 .55rem 2.1rem; font-size: .9688rem; line-height: 1.45; counter-increment: goal; }
  .goals li + li { border-top: 1px solid var(--border); }
  .goals li::before { content: counter(goal); position: absolute; left: 0; top: .6rem; display: grid; place-items: center;
                      width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--bg); color: var(--muted);
                      font-size: .75rem; font-weight: 600; }
  .goals a { color: var(--fg); }

  /* Sections are separated by space and a hairline, so a long page has places to pause. */
  main > section { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  header + section { margin-top: 2.5rem; padding-top: 0; border-top: 0; }
  h2 { margin: 0 0 1rem; font-size: 1.5rem; font-weight: 700; line-height: 1.2; letter-spacing: -.02em; }
  h3 { margin: 0 0 .3rem; font-size: 1.125rem; font-weight: 600; line-height: 1.35; letter-spacing: -.012em; }
  h4 { margin: 1.25rem 0 .4rem; font-size: .9375rem; font-weight: 600; }
  p { margin: 0 0 1.15rem; }
  code { font: .9em/1 var(--mono); color: inherit; letter-spacing: 0; }

  /* Code figures: where the code lives and what to look for, then the code. */
  .code { margin: 1.75rem 0; border-radius: 14px; overflow: hidden; background: var(--code-bg); color: var(--code-fg); }
  .code figcaption { display: flex; flex-direction: column; gap: .15rem; padding: .85rem 1.1rem .7rem; font-size: .875rem; line-height: 1.45; }
  .code .where { color: var(--code-path); font-weight: 600; font-size: .8125rem; }
  .code .lines { color: var(--code-dim); font-weight: 400; }
  .code .caption { color: var(--muted); }
  {{ code_css }}
  .code pre { margin: 0; padding: .25rem 1.1rem 1rem 0; overflow-x: auto; background: var(--code-bg); color: var(--code-fg);
              font: .8125rem/1.6 var(--mono); tab-size: 4; font-variant-ligatures: none; }
  .code pre code { font: inherit; color: inherit; }
  .ln { display: inline-block; width: 4ch; margin-right: 1.5ch; color: var(--code-dim); text-align: right; user-select: none; opacity: .8; }

  /* Diagrams: Mermaid and Graphviz draw for a light background, so the panel stays white in dark mode too.
     Shrunk to fit, but never below 45rem: a wide sequence diagram squeezed into the side panel has unreadable
     labels, so past that it scrolls sideways inside its panel. */
  .diagram { margin: 1.75rem 0; }
  .diagram .panel { overflow-x: auto; padding: 1.25rem; background: #fff; border-radius: 14px; box-shadow: inset 0 0 0 1px var(--fill-2); }
  .diagram img { display: block; margin: 0 auto; height: auto; max-width: max(100%, 45rem); }
  .diagram figcaption { margin-top: .6rem; text-align: center; font-size: .8125rem; color: var(--muted); }
  /* A full-white panel glows against a dark page; dim it a little. */
  @media (prefers-color-scheme: dark) { .diagram .panel { filter: brightness(.9); box-shadow: none; } }

  .callout { --c: var(--info); margin: 1.75rem 0; padding: .95rem 1.15rem; border-radius: 14px;
             background: color-mix(in srgb, var(--c) 7%, var(--bg)); }
  .callout p { margin: 0; font-size: .9688rem; }
  .callout .callout-label { display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem; color: var(--c);
                            font-size: .8125rem; font-weight: 600; }
  .tip { --c: var(--tip); } .info { --c: var(--info); } .warning { --c: var(--warning); }

  .tech { margin: 1.25rem 0; padding: 1.35rem 1.4rem; background: var(--fill); border-radius: 18px; }
  .tech .role { margin-bottom: 0; color: var(--muted); font-size: .9375rem; }
  .pros-cons { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .75rem; margin-top: 1rem; }
  .pros-cons > div { padding: .85rem 1rem; border-radius: 12px; background: var(--bg); }
  .pros-cons h4 { display: flex; align-items: center; gap: .4rem; margin-top: 0; color: var(--c); font-size: .8125rem; }
  .pros { --c: var(--tip); } .cons { --c: var(--warning); }
  .tech ul { margin: 0; padding-left: 1.1rem; font-size: .9375rem; }
  .tech li { margin: .3rem 0; }
  .alts { margin: 0; font-size: .9375rem; }
  .alts > div { padding: .6rem 0; border-bottom: 1px solid var(--border); }
  .alts > div:last-child { border-bottom: 0; }
  .alts dt { font-weight: 600; }
  .alts dd { margin: .1rem 0 0; }
  @media (min-width: 40rem) { .alts > div { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; } .alts dd { margin: 0; } }

  /* Self-quiz: the answer stays folded until the reader has tried to recall it. */
  .quiz-intro { color: var(--muted); font-size: .9688rem; }
  .question { margin: .75rem 0; padding: 1.15rem 1.3rem; background: var(--fill); border-radius: 18px; scroll-margin-top: 1.5rem; }
  .question h3 { margin-bottom: .8rem; font-size: 1.0625rem; line-height: 1.45; }
  .question summary { display: flex; align-items: center; gap: .4rem; cursor: pointer; width: fit-content; min-height: 2rem;
                      padding: .3rem .95rem; border-radius: 999px; background: var(--accent); color: var(--on-accent);
                      font-weight: 600; font-size: .875rem; list-style: none; }
  .question summary::-webkit-details-marker { display: none; }
  /* Chevron drawn in CSS so the summary keeps its plain-text markup. */
  .question summary::after { content: ""; width: .4em; height: .4em; margin: -.2em 0 0 .15em;
                             border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .question details[open] summary { margin-bottom: 1rem; background: var(--fill-2); color: var(--fg); }
  .question details[open] summary::after { margin-top: .2em; transform: rotate(-135deg); }
  .question details > p { font-size: .9688rem; }
  .question details > p:last-child { margin-bottom: 0; }

  main > .summary { margin-top: 3.5rem; padding: 1.5rem 1.5rem .4rem; border: 0; border-radius: 18px; background: var(--fill); }
  .summary-label { margin: 0 0 .3rem; font-size: .8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }

  @media print {
    .toc-side, .toc-top, .skip, .question summary { display: none; }
    details::details-content { content-visibility: visible; display: block; }
    .page { display: block; padding: 0; }
    main { max-width: none; }
    .code pre { white-space: pre-wrap; }
    .diagram img { max-width: 100%; }
    .code, .callout, .question, .tech { break-inside: avoid; }
    h2, h3 { break-after: avoid; }
  }
