{
  "name": "deep-diver-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "types": "cd .. && uv run python -c \"import json; from app.api.main import app; print(json.dumps(app.openapi()))\" > frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/schema.d.ts"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "pyodide": "^314.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
