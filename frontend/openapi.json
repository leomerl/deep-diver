ning a rule would make every older notebook unreadable."}, "NotebookCellBase": {"properties": {"explanation": {"type": "string", "title": "Explanation", "description": "What this cell shows and what to notice in its output, in one or two short paragraphs. Shown above the code."}, "code": {"type": "string", "minLength": 1, "title": "Code", "description": "Self-contained Python that runs in the reader's browser."}, "mirrors": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Mirrors", "description": "The repo file whose mechanism this cell rebuilds, relative to the repo root. Null for a cell that only sets up or sums up."}}, "type": "object", "required": ["explanation", "code"], "title": "NotebookCellBase"}, "NotebookJob": {"properties": {"deep_dive_id": {"type": "integer", "title": "Deep Dive Id"}}, "type": "object", "required": ["deep_dive_id"], "title": "NotebookJob", "description": "The notebook job payload; the worker re-validates it with the same class. The page must exist: the agent\nworks from it."}, "RepoCreate": {"properties": {"url": {"type": "string", "maxLength": 2048, "title": "Url"}}, "type": "object", "required": ["url"], "title": "RepoCreate", "description": "POST /repos body, and the index job payload (the worker re-validates with the same class)."}, "RepoMap": {"properties": {"nodes": {"items": {"$ref": "#/components/schemas/NodeRead"}, "type": "array", "title": "Nodes"}, "edges": {"items": {"$ref": "#/components/schemas/EdgeRead"}, "type": "array", "title": "Edges"}}, "type": "object", "required": ["nodes", "edges"], "title": "RepoMap", "description": "GET /repos/{id}/map: every area of the repo and the edges between them (the shape canvas libraries take)."}, "RepoRead": {"properties": {"url": {"type": "string", "maxLength": 2048, "title": "Url"}, "id": {"type": "integer", "title": "Id"}, "commit_sha": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Commit Sha"}, "status": {"$ref": "#/components/schemas/RepoStatus"}, "added_by": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Added By"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}}, "type": "object", "required": ["url", "id", "commit_sha", "status", "added_by", "created_at"], "title": "RepoRead"}, "RepoStatus": {"type": "string", "enum": ["indexing", "indexed", "failed"], "title": "RepoStatus"}, "SnapshotBase": {"properties": {"repo_id": {"type": "integer", "title": "Repo Id"}, "commit_sha": {"type": "string", "maxLength": 40, "title": "Commit Sha"}}, "type": "object", "required": ["repo_id", "commit_sha"], "title": "SnapshotBase"}, "StepStatus": {"type": "string", "enum": ["passed", "running", "failed", "waiting", "skipped"], "title": "StepStatus"}, "UserRead": {"properties": {"github_id": {"type": "integer", "title": "Github Id"}, "login": {"type": "string", "maxLength": 64, "title": "Login"}, "id": {"type": "integer", "title": "Id"}}, "type": "object", "required": ["github_id", "login", "id"], "title": "UserRead"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
