{"openapi": "3.1.0", "info": {"title": "deep-diver", "version": "0.1.0"}, "paths": {"/auth/github/login": {"get": {"tags": ["auth"], "summary": "Github Login", "description": "Send the browser to GitHub. The random `state` comes back in the callback and must match this cookie (CSRF).", "operationId": "github_login_auth_github_login_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/auth/github/callback": {"get": {"tags": ["auth"], "summary": "Github Callback", "operationId": "github_callback_auth_github_callback_get", "parameters": [{"name": "code", "in": "query", "required": true, "schema": {"type": "string", "title": "Code"}}, {"name": "state", "in": "query", "required": true, "schema": {"type": "string", "title": "State"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/me": {"get": {"tags": ["auth"], "summary": "Me", "description": "The logged-in user, or null.", "operationId": "me_auth_me_get", "parameters": [{"name": "session", "in": "cookie", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Session"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/UserRead"}, {"type": "null"}], "title": "Response Me Auth Me Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/github/repos": {"get": {"tags": ["auth"], "summary": "Github Repos", "description": "Every repo the user's token can read, private ones included.", "operationId": "github_repos_auth_github_repos_get", "parameters": [{"name": "session", "in": "cookie", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Session"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/GitHubRepo"}, "title": "Response Github Repos Auth Github Repos Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/repos": {"post": {"tags": ["repos"], "summary": "Add Repo", "description": "Idempotent: a repo that was already added is accepted again and not re-queued.", "operationId": "add_repo_repos_post", "parameters": [{"name": "session", "in": "cookie", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Session"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RepoCreate"}}}}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RepoCreate"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["repos"], "summary": "List Repos", "operationId": "list_repos_repos_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RepoRead"}, "title": "Response List Repos Repos Get"}}}}}}}, "/repos/{repo_id}/map": {"get": {"tags": ["repos"], "summary": "Get Map", "description": "Every area of the repo and the edges between them; the client draws the tree from the `contains` edges.", "operationId": "get_map_repos__repo_id__map_get", "parameters": [{"name": "repo_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Repo Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RepoMap"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/nodes/{node_id}": {"get": {"tags": ["nodes"], "summary": "Get Node", "operationId": "get_node_nodes__node_id__get", "parameters": [{"name": "node_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Node Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NodeWithChildren"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/nodes/{node_id}/deep-dive": {"post": {"tags": ["deep dives"], "summary": "Request Deep Dive", "description": "Idempotent: a node that was already requested is accepted again and not re-queued.", "operationId": "request_deep_dive_nodes__node_id__deep_dive_post", "parameters": [{"name": "node_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Node Id"}}], "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeepDiveCreate"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["deep dives"], "summary": "Get Deep Dive", "description": "404 until the deep dive is written.", "operationId": "get_deep_dive_nodes__node_id__deep_dive_get", "parameters": [{"name": "node_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Node Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeepDiveRead"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/nodes/{node_id}/deep-dive/html": {"get": {"tags": ["deep dives"], "summary": "Get Deep Dive Html", "operationId": "get_deep_dive_html_nodes__node_id__deep_dive_html_get", "parameters": [{"name": "node_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Node Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"text/html": {"schema": {"type": "string"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"DeepDiveCreate": {"properties": {"node_id": {"type": "integer", "title": "Node Id"}}, "type": "object", "required": ["node_id"], "title": "DeepDiveCreate", "description": "The deep dive job payload; the worker re-validates it with the same class."}, "DeepDiveRead": {"properties": {"node_id": {"type": "integer", "title": "Node Id"}, "id": {"type": "integer", "title": "Id"}, "object_key": {"type": "string", "title": "Object Key"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}}, "type": "object", "required": ["node_id", "id", "object_key", "created_at"], "title": "DeepDiveRead"}, "EdgeKind": {"type": "string", "enum": ["contains"], "title": "EdgeKind"}, "EdgeRead": {"properties": {"source_id": {"type": "integer", "title": "Source Id"}, "target_id": {"type": "integer", "title": "Target Id"}, "kind": {"$ref": "#/components/schemas/EdgeKind"}, "label": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Label"}, "id": {"type": "integer", "title": "Id"}}, "type": "object", "required": ["source_id", "target_id", "kind", "id"], "title": "EdgeRead"}, "GitHubRepo": {"properties": {"full_name": {"type": "string", "title": "Full Name"}, "html_url": {"type": "string", "title": "Html Url"}, "private": {"type": "boolean", "title": "Private"}}, "type": "object", "required": ["full_name", "html_url", "private"], "title": "GitHubRepo"}, "Grouping": {"type": "string", "enum": ["llm", "fallback"], "title": "Grouping", "description": "How a node was made."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "NodeRead": {"properties": {"name": {"type": "string", "title": "Name"}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Description"}, "paths": {"items": {"type": "string"}, "type": "array", "title": "Paths"}, "grouping": {"$ref": "#/components/schemas/Grouping", "default": "llm"}, "id": {"type": "integer", "title": "Id"}}, "type": "object", "required": ["name", "paths", "id"], "title": "NodeRead"}, "NodeWithChildren": {"properties": {"name": {"type": "string", "title": "Name"}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Description"}, "paths": {"items": {"type": "string"}, "type": "array", "title": "Paths"}, "grouping": {"$ref": "#/components/schemas/Grouping", "default": "llm"}, "id": {"type": "integer", "title": "Id"}, "children": {"items": {"$ref": "#/components/schemas/NodeRead"}, "type": "array", "title": "Children"}}, "type": "object", "required": ["name", "paths", "id", "children"], "title": "NodeWithChildren", "description": "GET /nodes/{id} response."}, "RepoCreate": {"properties": {"url": {"type": "string", "maxLength": 2048, "title": "Url"}}, "type": "object", "required": ["url"], "title": "RepoCreate", "description": "POST /repos body, and the index job payload (the worker re-validates with the same class)."}, "RepoMap": {"properties": {"nodes": {"items": {"$ref": "#/components/schemas/NodeRead"}, "type": "array", "title": "Nodes"}, "edges": {"items": {"$ref": "#/components/schemas/EdgeRead"}, "type": "array", "title": "Edges"}}, "type": "object", "required": ["nodes", "edges"], "title": "RepoMap", "description": "GET /repos/{id}/map: every area of the repo and the edges between them (the shape canvas libraries take)."}, "RepoRead": {"properties": {"url": {"type": "string", "maxLength": 2048, "title": "Url"}, "id": {"type": "integer", "title": "Id"}, "commit_sha": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Commit Sha"}, "status": {"$ref": "#/components/schemas/RepoStatus"}, "added_by": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Added By"}, "created_at": {"type": "string", "format": "date-time", "title": "Created At"}}, "type": "object", "required": ["url", "id", "commit_sha", "status", "added_by", "created_at"], "title": "RepoRead"}, "RepoStatus": {"type": "string", "enum": ["indexing", "indexed", "failed"], "title": "RepoStatus"}, "UserRead": {"properties": {"github_id": {"type": "integer", "title": "Github Id"}, "login": {"type": "string", "maxLength": 64, "title": "Login"}, "id": {"type": "integer", "title": "Id"}}, "type": "object", "required": ["github_id", "login", "id"], "title": "UserRead"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
