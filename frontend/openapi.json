, "summary": "Get Deep Dive Page", "description": "Any page by its own id. The node and repo routes only reach the current snapshot's root page.", "operationId": "get_deep_dive_page_deep_dives__deep_dive_id__html_get", "parameters": [{"name": "deep_dive_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Deep Dive Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"text/html": {"schema": {"type": "string"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/deep-dives/{deep_dive_id}/notebook": {"get": {"tags": ["deep dives"], "summary": "Get Notebook", "description": "404 when the deep dive has no notebook: its agent failed, or the page predates notebooks.", "operationId": "get_notebook_deep_dives__deep_dive_id__notebook_get", "parameters": [{"name": "deep_dive_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Deep Dive Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotebookBase"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "post": {"tags": ["deep dives"], "summary": "Request Notebook", "description": "Queue the page's notebook. Idempotent: a page already queued isn't queued again, and a page that has a notebook\nmakes the job a no-op. A dead-lettered job frees its marker, so this is how a failed notebook is retried.", "operationId": "request_notebook_deep_dives__deep_dive_id__notebook_post", "parameters": [{"name": "deep_dive_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Deep Dive Id"}}], "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotebookJob"}}}}, "422": {"description": 