# The API, serving the built frontend from /srv/frontend/dist (app/api/main.py mounts it when present).
# Also the image for the one-shot `migrate` service, so migrations run from the same code the API imports.
FROM node:22-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /bin/uv

# git: POST /repos runs `git ls-remote` to reject private or missing repos before queueing.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home api
WORKDIR /srv

# Dependencies first, so code changes don't reinstall them (layer cache).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini ./
COPY migrations ./migrations
COPY app ./app
COPY --from=frontend /build/dist ./frontend/dist
USER api

ENV GIT_ALLOW_PROTOCOL=https \
    PATH=/srv/.venv/bin:$PATH

EXPOSE 8000
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
